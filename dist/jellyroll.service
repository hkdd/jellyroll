# Jellyroll: the only graphical process on the machine.
# Installed by scripts/install.sh. Boot target is multi-user.target with no
# display manager (NOT rescue.target, which starts no networking).
[Unit]
Description=Jellyroll (Jellyfin HTPC client)
After=systemd-user-sessions.service systemd-logind.service network-online.target sound.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=jellyroll
# PAMName opens a logind session on tty1, so the seat ACLs grant DRM master
# and /dev/input access. If your distro's PAM stack does not, the install
# script also adds the user to video/render/input as a fallback.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/jellyroll
Restart=always
RestartSec=1
# The render loop pings the watchdog itself (WATCHDOG=1 every 10 s), so a
# hung loop gets the process restarted.
WatchdogSec=20
Type=notify
NotifyAccess=main

# Hardening (spec 12). Enabled options are compatible with KMS/input access
# by design; the commented ones must be validated on the reference hardware
# before enabling (see docs/DECISIONS.md).
NoNewPrivileges=yes
PrivateTmp=yes
#ProtectSystem=strict
#ReadWritePaths=/home/jellyroll/.config/jellyroll /home/jellyroll/.local/share/jellyroll /home/jellyroll/.cache/jellyroll
#ProtectHome=read-only

[Install]
WantedBy=multi-user.target
