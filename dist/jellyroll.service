# Jellyroll: the only graphical process on the machine.
# Installed by scripts/install.sh. Boot target is multi-user.target with no
# display manager (NOT rescue.target, which starts no networking).
[Unit]
Description=Jellyroll (Jellyfin HTPC client)
After=systemd-user-sessions.service systemd-logind.service network-online.target sound.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=jellyroll
# PAMName opens a logind session on tty1, so the seat ACLs grant DRM master
# and /dev/input access. If your distro's PAM stack does not, the install
# script also adds the user to video/render/input as a fallback.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/jellyroll
Restart=always
RestartSec=1
# The render loop pings the watchdog itself (WATCHDOG=1 every 10 s), so a
# hung loop gets the process restarted.
WatchdogSec=20
Type=notify
NotifyAccess=main

# Hardening (spec 12, D61). None of these touch /dev (DRM, input, CEC,
# sound) or /run (D-Bus for logind, PipeWire), so display, input, audio
# and the power menu keep working. The filesystem is read-only except the
# app's data directory and ~/.cache (also Mesa's shader cache) (scripts/install.sh creates them,
# and rewrites /home/jellyroll for another user). If something breaks on
# your hardware, comment out ProtectSystem/ProtectHome first.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jellyroll/.local/share/jellyroll /home/jellyroll/.cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
